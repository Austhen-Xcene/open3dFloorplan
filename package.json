{
	"name": "editor-planta-2d",
	"private": true,
	"version": "0.9.0",
	"description": "Editor 2D de plantas com ambientes de medidas exatas e cat\u00e1logo de objetos",
	"author": "theLodgeStudio",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Austhen-Xcene/open3dFloorplan.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "playwright test",
		"test:ui": "playwright test --ui",
		"test:doc": "playwright test && echo \"evid\u00eancias regeneradas em docs/ui/_evidencias/\""
	},
	"devDependencies": {
		"@playwright/test": "^1.62.0",
		"@sveltejs/adapter-node": "^5.5.3",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.1.18",
		"firebase": "^12.9.0",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"dxf-writer": "^1.18.4",
		"jspdf": "^4.1.0"
	}
}
