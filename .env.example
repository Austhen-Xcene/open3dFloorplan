# Configuração do Firebase.
#
# Copie para `.env` e preencha com os dados do SEU projeto (Console do Firebase →
# Configurações do projeto → Seus apps → Configuração do SDK).
#
# Sem estas variáveis o app funciona normalmente: o Firebase fica inerte e o projeto
# do usuário continua salvo no localStorage do navegador.
#
# São credenciais PÚBLICAS de cliente — vão para o bundle e isso é esperado. O que protege
# os dados são as Regras de Segurança do Firestore, não o segredo destas chaves.

PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=
